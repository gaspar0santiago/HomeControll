# ── Secrets ───────────────────────────────────────────────────
# Tapo account, camera RTSP credentials, Tuya plug local keys.
.env
.env.*
!.env.example

# tinytuya wizard output. These are generated by `python -m tinytuya wizard`
# and contain the Tuya *cloud* API key/secret and every plug's local key.
# Regenerate them on the host; never commit them.
tinytuya.json
devices.json
snapshot.json
tuya-raw.json

