// Copy to config.h and fill in. config.h is gitignored; this file is not,
// so never put a real value in here.
//
//   cp config.h.example config.h
//
#pragma once

// ── WiFi ──────────────────────────────────────────────────────
// Must be a 2.4GHz network. The ESP32 has no 5GHz radio at all. A merged
// SSID covering both bands usually works; if the board never connects and
// the password is definitely right, this is why.
#define WIFI_SSID       "your-wifi"
#define WIFI_PASSWORD   "your-wifi-password"

// ── Supabase ──────────────────────────────────────────────────
// Your project ref is the first part of the project URL in the Supabase
// dashboard.
//
// This is the REST endpoint, not an Edge Function. A 2 second poll is
// about 1.3 million calls a month, which is well past the free tier's
// 500,000 Edge Function invocations, while REST requests are unlimited.
// Same database, same door_claim(), same row lock.
#define DOOR_POLL_URL   "https://YOUR-PROJECT-REF.supabase.co/rest/v1/rpc/door_claim"

// The anon key, from Supabase Settings > API. It is not a secret: it is
// designed to be shipped to browsers, and on its own it opens nothing here.
// RLS is on with no policies, anon holds no table grants, and door_claim is
// the only function it may call. Without the device key below, that call
// returns nothing.
#define SUPABASE_ANON_KEY "paste-the-anon-key"

// The device key, from:  node tools/make-key.js device
// This is the credential that matters. It cannot read the passes table, it
// cannot read the attempt log, and it cannot queue an open. All it can do
// is claim a command somebody already earned. Rotate it on its own, without
// touching the dashboard key.
#define DOOR_DEVICE_KEY "paste-the-device-key"

// A name for this board, so claimed_by in door_commands says who took it.
#define DOOR_DEVICE_NAME "esp32-street-door"

// ── Home controller notify (optional) ─────────────────────────
// Told, over the LAN, immediately after the relay pulses, so the kiosk can
// flash a bulb without polling Supabase every few seconds for it. Leave
// empty to skip it entirely.
//
// Not in the door's path: this fires after the door has already opened, and
// nothing waits on the reply. The controller being off changes nothing.
#define HOME_CONTROLLER_NOTIFY_URL "http://192.168.68.57:3000/door/opened"

// ── Bench test ────────────────────────────────────────────────
// Set to 1 and the sketch skips WiFi, TLS and Supabase entirely: it just
// pulses the relay every few seconds and prints what it is doing. Use it
// to prove the wiring and the jumper setting on the bench, with nothing
// connected to the intercom. Set it back to 0 before you install it.
#define DOOR_BENCH_TEST 0

// ── Relay wiring ──────────────────────────────────────────────
// The pin driving IN on the relay module.
//
// GPIO26 on the 30 pin DevKit: a plain GPIO, not a strapping pin, not one
// of the flash pins, and it does not pulse during boot. Do not move this
// to GPIO 0, 2, 4, 5, 12 or 15 (strapping pins, some of which are driven
// during boot), 6 to 11 (wired to the flash chip), or 1 and 3 (the USB
// serial port, which spews the boot log). GPIO 34 to 39 are input only and
// cannot drive a relay at all.
#define RELAY_PIN 26

// Which way the module's jumper is set. 1 for LOW trigger, 0 for HIGH.
//
// Default is HIGH, and that is deliberate on a door. In HIGH mode the
// module's IN pin sits behind the optocoupler LED to ground, so an
// undriven pin cannot rise past the LED's forward voltage and the relay
// physically cannot close. Every reset, brownout, watchdog and reflash is
// therefore safe by construction, with no resistor and no reliance on the
// firmware getting its pin ordering right.
//
// In LOW mode an undriven pin is the ON state, which is the failure this
// whole design is trying to avoid.
//
// The catch: HIGH trigger drives the LED straight from the ESP32's 3.3V,
// and this module is specified at 5(mA) trigger current. It usually works
// and sometimes does not, depending on the resistor the manufacturer
// fitted. That is a ten second bench test, and it fails safe: the worst
// case is a relay that never clicks, which you will notice immediately.
//
// If HIGH will not click reliably, set this to 1 and see the LOW TRIGGER
// FALLBACK note in ../../README.md. It needs one 10k resistor.
#define RELAY_ACTIVE_LOW 0

// ── TLS ───────────────────────────────────────────────────────
// PASTE THE ROOT CERTIFICATE HERE. While this is empty the board still
// works, but it does not verify who it is talking to, and anyone who can
// redirect its traffic can read the device key straight off the wire.
//
// Get it with:
//
//   openssl s_client -showcerts -connect YOUR-PROJECT-REF.supabase.co:443 </dev/null
//
// and paste the LAST certificate in the chain (the root) between the
// markers below, BEGIN and END lines included.
//
// If polling starts failing with a TLS error months from now, the root
// rotated: repeat the command above and paste the new one. The physical
// intercom button is unaffected either way, so a stale certificate stops
// the web page working, not the building.
static const char SUPABASE_ROOT_CA[] = R"CERT(
)CERT";
