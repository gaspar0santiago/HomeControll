# Copy to .env and fill in real values. .env is gitignored -- keep it that way.

# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── Tapo (TP-Link) cloud account, used by tapo_helper.py ──────
# The bulbs are reached over LAN, but the KLAP handshake still
# authenticates against these account credentials.
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-tapo-password

# ── Cameras (RTSP) ────────────────────────────────────────────
CAMERA_IP=192.168.68.xx
CAMERA2_IP=192.168.68.xx
CAMERA_USERNAME=camera-user
CAMERA_PASSWORD=camera-password

# ── Tuya / Arlec smart plugs, used by plug_helper.py ──────────
# Local keys, from `python -m tinytuya wizard`. LAN-only, no cloud
# calls at runtime. Treat the keys like passwords.
PLUG_DISCO_ID=
PLUG_DISCO_IP=192.168.68.86
PLUG_DISCO_KEY=
PLUG_DISCO_VER=3.3

PLUG_SPOTLIGHT_ID=
PLUG_SPOTLIGHT_IP=192.168.68.88
PLUG_SPOTLIGHT_KEY=
PLUG_SPOTLIGHT_VER=3.3

PLUG_SPOTLIGHT2_ID=
PLUG_SPOTLIGHT2_IP=192.168.68.81
PLUG_SPOTLIGHT2_KEY=
PLUG_SPOTLIGHT2_VER=3.5

# ── Hello Fairy BLE curtains ──────────────────────────────────
# The server takes the MAC from the request body, so these are only
# used by tools/fairy_test.py.
FAIRY1_MAC=FF:24:12:11:07:D6
FAIRY2_MAC=FF:24:12:11:0D:C6

# ── Spotify (currently unused) ────────────────────────────────
# package.json still pulls in spotify-web-api-node, but server.js
# never touches these. Left here so the .env matches the install.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
