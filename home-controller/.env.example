# Copy to .env and fill in real values. .env is gitignored -- keep it that way.

# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── Tapo (TP-Link) cloud account, used by tapo_helper.py ──────
# The bulbs are reached over LAN, but the KLAP handshake still
# authenticates against these account credentials.
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-tapo-password

# ── Cameras (RTSP) ────────────────────────────────────────────
# Leave a camera's IP EMPTY to disable it: the stream is not started, its
# route is not registered, and the kiosk hides the tile. Fill it back in
# and restart to bring the camera back -- no code change needed.
CAMERA_IP=
CAMERA2_IP=192.168.68.xx
CAMERA_USERNAME=camera-user
CAMERA_PASSWORD=camera-password

# Which camera drives the motion-wake detector (1 or 2). Defaults to the
# first configured camera, so this only matters when both are running.
MOTION_CAMERA=

# Override if ffmpeg is not at C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# ── Tuya / Arlec smart plugs, used by plug_helper.py ──────────
# Local keys, from `python -m tinytuya wizard`. LAN-only, no cloud
# calls at runtime. Treat the keys like passwords.
PLUG_DISCO_ID=
PLUG_DISCO_IP=192.168.68.86
PLUG_DISCO_KEY=
PLUG_DISCO_VER=3.3

PLUG_SPOTLIGHT_ID=
PLUG_SPOTLIGHT_IP=192.168.68.88
PLUG_SPOTLIGHT_KEY=
PLUG_SPOTLIGHT_VER=3.3

PLUG_SPOTLIGHT2_ID=
PLUG_SPOTLIGHT2_IP=192.168.68.81
PLUG_SPOTLIGHT2_KEY=
PLUG_SPOTLIGHT2_VER=3.5

# ── Hello Fairy BLE curtains ──────────────────────────────────
# The server takes the MAC from the request body, so these are only
# used by tools/fairy_test.py.
FAIRY1_MAC=FF:24:12:11:07:D6
FAIRY2_MAC=FF:24:12:11:0D:C6

# ── Street door panel (read only) ─────────────────────────────
# Mirrors the door opener's attempt log onto the main kiosk and flashes a
# bulb when the door opens. See ../door-opener/README.md.
#
# Leave DOOR_EVENTS_URL empty to switch the whole thing off: the panel
# hides itself and nothing is polled. The door does not depend on any of
# this, and this server never opens the door.
DOOR_EVENTS_URL=
DOOR_DASHBOARD_KEY=

# Which Tapo bulb flashes on a successful open. Leave empty for no flash.
# A colour bulb (L530 / L630) restores exactly; the L920 bar strip cannot,
# because its effects cannot be read back.
DOOR_FLASH_IP=192.168.68.61
DOOR_FLASH_HUE=120
DOOR_FLASH_SATURATION=90
DOOR_FLASH_BRIGHTNESS=100
DOOR_FLASH_MS=2500

# Do not flash between these times. HH:MM, and the window may cross
# midnight. Leave either empty to flash at any hour.
DOOR_QUIET_FROM=23:00
DOOR_QUIET_TO=07:00

# ── Spotify (currently unused) ────────────────────────────────
# package.json still pulls in spotify-web-api-node, but server.js
# never touches these. Left here so the .env matches the install.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
